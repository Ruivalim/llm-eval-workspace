# Copy to .env and fill in. Never commit .env.
#
# The bench talks to any OpenAI-compatible endpoint. Nothing here is needed to
# start: the UI lets you add servers at runtime, and its starter suggestions
# cover Ollama and llama.cpp.
#
# Optional: seed one server into a fresh database. Without these two, a fresh
# install opens with no server configured.
LLM_EVAL_DEFAULT_BASE_URL=
LLM_EVAL_DEFAULT_API_KEY=
# LLM_EVAL_DEFAULT_FLAVOR=openai   # `anthropic` for Claude, `unsloth` adds the loaded-model panel
#
# js_harness checks execute model-generated JavaScript on this machine, with no
# sandbox. Off by default: read SECURITY.md first.
# LLM_EVAL_ALLOW_CODE_EXEC=1
#
# This API has no authentication and stores your keys in plain text. Keep it on
# loopback (`make api` binds 127.0.0.1) or behind a VPN. Never on the open net.
#
# LLM_EVAL_DB=data/llm_eval.db
# LLM_EVAL_LOCALE=en
# LLM_EVAL_ARTIFACTS=data/artifacts
# LLM_EVAL_TRACES=data/traces      one JSONL per evaluation, every raw chunk
# LLM_EVAL_LOGS=data/logs          rotating application log
# LLM_EVAL_LOG_LEVEL=INFO
